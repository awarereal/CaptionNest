# Pinned versions of the third-party tools bundled with CaptionNest.
# Every build script (macOS, Windows, CI) reads this file so all platforms ship identical sources.
# Format: plain KEY=VALUE lines (sourced by bash, parsed by PowerShell).

FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e

WHISPER_VERSION=v1.9.6
WHISPER_URL=https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v1.9.6.tar.gz
WHISPER_SHA256=7ab15dc88022d2425ad94dcffd8abbf1b6d7018089b4e48d6b40780738e0b445

VAD_MODEL_NAME=ggml-silero-v6.2.0.bin
VAD_MODEL_URL=https://huggingface.co/ggml-org/whisper-vad/resolve/main/ggml-silero-v6.2.0.bin
VAD_MODEL_SHA256=2aa269b785eeb53a82983a20501ddf7c1d9c48e33ab63a41391ac6c9f7fb6987

# Oldest macOS release the bundled tools and the app target.
MACOS_DEPLOYMENT_TARGET=13.3
