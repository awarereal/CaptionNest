{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaptionNest",
  "version": "0.1.0",
  "identifier": "com.captionnest.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CaptionNest",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "backgroundColor": "#14110E",
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "media-src": "'self' blob: asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Aware",
    "copyright": "Made by Aware. © 2026 Aware. MIT License.",
    "category": "Video",
    "shortDescription": "Turn video speech into editable captions for CapCut",
    "longDescription": "CaptionNest turns the speech in a video into accurate, editable captions on your computer and exports an SRT file for CapCut. Captions are made offline after the one-time model download; optional online recognition (Sarvam) and voice typing (Deepgram) use your own API keys.",
    "resources": {
      "resources/tools/*": "tools/",
      "resources/bundled-models/*": "bundled-models/",
      "resources/licenses/*": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 640,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 460,
          "y": 190
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
